SUPABASE_URL=https://your-project.supabase.co
SUPABASE_WORKER_KEY=your-dedicated-worker-key
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_STT_MODEL=openai/whisper-large-v3-turbo
TRANSCRIPTION_LANGUAGE=en
WORKER_POLL_MS=2000
WORKER_CONCURRENCY=1
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
PORT=8080

# Source Audio Backup. The worker holds only public wrapping material and the
# mTLS client certificate for the create-only receiver; it has no AWS
# credential and never sees the offline age identity. The age recipient itself
# is registered in backup_key_versions, not here.
BACKUP_VPS_URL=https://backup.vps.example
BACKUP_VPS_CLIENT_CERT=
BACKUP_VPS_CLIENT_KEY=
BACKUP_VPS_CA_CERT=
BACKUP_KMS_PUBLIC_KEY=

# The retention principal, which is the only thing that can delete a backup.
# It uses a different client certificate and a different database role, and can
# read no Call, Transcript, or wrapped key.
RETENTION_VPS_CLIENT_CERT=
RETENTION_VPS_CLIENT_KEY=
SUPABASE_RETENTION_KEY=
