SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
APP_URL=http://localhost:3000
CSP_MODE=enforce
HSTS_INCLUDE_SUBDOMAINS=false

# Monitoring. Server-side only: the browser posts envelopes to the same-origin
# /api/monitoring tunnel and never learns the destination. See
# docs/operations/sentry.md.
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_RELEASE=
TELEMETRY_CRITICAL_SAMPLE_RATE=1
TELEMETRY_ROUTINE_SAMPLE_RATE=0.1
